# Citation File Format 1.2.0 — https://citation-file-format.github.io
#
# Every field below is copied from a file in this repository, named in the comment
# above it. Nothing here is remembered, inferred, or filled in to look complete.
#
# Release metadata: date-released is supplied by the authorized release cut
# and matches this software version's dated entry in CHANGELOG.md. The date
# is quoted to preserve a string under both supported YAML readers.
#
# The following reference remains omitted deliberately:
#
#   references (arXiv 2606.10154) — NOT INCLUDED, and the reason is specific. The
#     repository cites that paper twice and both citations are quotable:
#       quantfit/policy/probe.py: "Quality Is Not a Safety Proxy Under Quantization",
#         https://arxiv.org/abs/2606.10154
#       ROADMAP.md: "our own paper's point (arXiv 2606.10154)"; risk 3 calls it "the
#         maintainer's paper"; 0.5 lists a "Replication package for arXiv 2606.10154".
#     What is NOT in this repository is an author list. CFF 1.2.0 requires `authors`
#     on every entry of `references`, and naming one author on a paper whose author
#     list I have not read would invent the field. Resolve it by opening
#     https://arxiv.org/abs/2606.10154 and copying the authors verbatim; the title and
#     URL above are already verified against probe.py and may be used as-is. The block
#     that edit produces — a nested `authors:` sequence inside a `references:` item —
#     is supported by tests/test_refreports.py's reader and is exercised there against
#     both parsers, so adding it SATISFIES the no-unsourced-claim test rather than
#     breaking the file:
#
#         references:
#           - type: "article"
#             title: "Quality Is Not a Safety Proxy Under Quantization"
#             url: "https://arxiv.org/abs/2606.10154"
#             authors:
#               - family-names: "<verbatim from the arXiv record>"
#                 given-names: "<verbatim from the arXiv record>"

cff-version: "1.2.0"
message: "If you use quantfit or the QSR measurement protocol, please cite this software."
title: "quantfit"
type: software

# pyproject.toml [project] authors = [{ name = "Sahil Kadadekar" }]
authors:
  - family-names: "Kadadekar"
    given-names: "Sahil"

# pyproject.toml `version = "0.48.0"`, and quantfit/__init__.py `__version__ = "0.48.0"`.
# tests/test_meta.py already pins those two to each other; tests/test_refreports.py
# pins this line to both, so the citation cannot drift from what the tool ships.
version: "0.48.0"
# Unreleased source candidate: date-released is added only at the authorized release cut.

# pyproject.toml `license = "Apache-2.0"` (PEP 639 SPDX expression); LICENSE is Apache 2.0.
license: "Apache-2.0"

# pyproject.toml [project.urls] Repository / Homepage
repository-code: "https://github.com/Sahil170595/quantfit"
url: "https://github.com/Sahil170595/quantfit"

# pyproject.toml [project] description, verbatim.
abstract: "Quantize an LLM and check it still refuses what it should — a GPU-aware quantization CLI that measures the safety drift of the quantization it just performed."

# pyproject.toml [project] keywords, verbatim and in order.
keywords:
  - "llm"
  - "quantization"
  - "awq"
  - "gptq"
  - "gguf"
  - "fp8"
  - "gpu"
  - "safety"
